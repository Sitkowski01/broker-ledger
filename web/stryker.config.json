{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --config vitest.logic.config.ts"
  },
  "mutate": [
    "src/app/core/format/*.ts",
    "src/app/core/events/sse.ts",
    "src/app/core/account/balances.ts",
    "src/app/core/account/documents.ts",
    "src/app/core/orders/order-toast.ts",
    "src/app/features/**/*-model.ts",
    "src/app/features/ledger/today.ts",
    "src/app/demo/demo-ledger.ts",
    "src/app/demo/demo-views.ts",
    "src/app/demo/demo-broker.ts",
    "!src/**/*.spec.ts"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 6,
  "timeoutMS": 30000
}
