{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "broker-ledger",
    "Audience": "broker-ledger-clients",
    "Lifetime": "01:00:00"
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ClientPerMinute": 120
  }
}
