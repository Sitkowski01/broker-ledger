{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "broker-ledger",
    "Audience": "broker-ledger-clients",
    "Lifetime": "01:00:00"
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ClientPerMinute": 120
  },
  "Exchange": {
    "BaseUrl": "http://localhost:8090/",
    "Timeout": "00:00:05"
  },
  "Orders": {
    "Reconciler": {
      "Enabled": true,
      "Interval": "00:00:05",
      "MinAge": "00:00:15",
      "BatchSize": 50
    },
    "Settlement": {
      "Enabled": true,
      "Interval": "00:00:00.250",
      "BatchSize": 200
    }
  },
  "ExchangeEvents": {
    "Topic": "exchange.events",
    "GroupId": "broker-ledger",
    "RetryDelay": "00:00:01"
  }
}
